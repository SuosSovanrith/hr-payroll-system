# ---- .env for EC2 deployment: put the SAME file on all 4 instances (copy to deploy/.env) ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
INTERNAL_API_KEY=change-me-to-another-long-random-string
REDIS_URL=redis://redis:6379

# EC2-A services run in the same compose project as the gateways -> docker names work:
REGISTRATION_SERVICE_URL=http://registration-service:3001
LOGIN_SERVICE_URL=http://login-service:3002

# Everything else lives on other instances -> use their PRIVATE IPs (EC2 console > Private IPv4 address):
EMPLOYEE_SERVICE_URL=http://EC2_B_PRIVATE_IP:3003
ATTENDANCE_SERVICE_URL=http://EC2_B_PRIVATE_IP:3004
LEAVE_SERVICE_URL=http://EC2_C_PRIVATE_IP:3005
PERFORMANCE_SERVICE_URL=http://EC2_C_PRIVATE_IP:3006
PAYROLL_SERVICE_URL=http://EC2_D_PRIVATE_IP:3007
AUDIT_SERVICE_URL=http://EC2_D_PRIVATE_IP:3008
