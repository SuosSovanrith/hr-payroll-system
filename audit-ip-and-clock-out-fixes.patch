+// [NEW] PUT /api/attendance/:id  (HR, Admin)   Body: { clockIn?, clockOut?, workLog? }  (ISO date-times)
+// Fixes a forgotten or wrong clock-in/out. Totals, overtime and status are recalculated.
+const parseDateTime = (value, field) => {
