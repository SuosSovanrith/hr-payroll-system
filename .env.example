# ---- Root .env for LOCAL docker compose (copy to .env, never commit .env) ----
# MongoDB Atlas connection string (one cluster; each service uses its own database name)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Secret used to SIGN tokens (Login) and VERIFY them (Gateway). Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Shared secret between the gateway and every service (proves a request came through the gateway)
INTERNAL_API_KEY=change-me-to-another-long-random-string

# Redis (load-balancing demo counter)
REDIS_URL=redis://redis:6379

# Where each service lives. Locally these are docker-compose service names.
REGISTRATION_SERVICE_URL=http://registration-service:3001
LOGIN_SERVICE_URL=http://login-service:3002
EMPLOYEE_SERVICE_URL=http://employee-service:3003
ATTENDANCE_SERVICE_URL=http://attendance-service:3004
LEAVE_SERVICE_URL=http://leave-service:3005
PERFORMANCE_SERVICE_URL=http://performance-service:3006
PAYROLL_SERVICE_URL=http://payroll-service:3007
AUDIT_SERVICE_URL=http://audit-service:3008
