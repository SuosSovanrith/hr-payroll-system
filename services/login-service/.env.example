# Local dev only (npm run dev). Docker uses the root / deploy .env file instead.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
INTERNAL_API_KEY=change-me-internal-key
PORT=3002
DB_NAME=hr_auth
AUDIT_SERVICE_URL=http://localhost:3008
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=1h
